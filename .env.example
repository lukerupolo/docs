# Storage backend selection.
# If S3_BUCKET is set (and AWS credentials are available), data is stored in S3.
# Otherwise the app falls back to local JSON files under .data/ (great for dev).

# --- S3 storage (provide these to enable S3) ---
S3_BUCKET=
S3_PREFIX=lingo
AWS_REGION=us-east-1
# Credentials: provide via standard AWS env vars or an instance/role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Local storage (used when S3_BUCKET is empty) ---
DATA_DIR=.data

# Default language for new lessons / words
DEFAULT_LANGUAGE=es
